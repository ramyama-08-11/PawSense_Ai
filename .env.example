# Copy this file to .env and fill in your keys
# Server-side Google API key (Places API). Restrict by server IP if possible.
GOOGLE_SERVER_KEY=

# Browser Google API key (Maps JavaScript). Restrict by HTTP referrers (your domain, localhost).
GOOGLE_BROWSER_KEY=

# Google Generative AI / Gemini API key used by the server for image analysis
# (if you use a different key for generative AI keep it here)
GOOGLE_API_KEY=

# Optional: other environment variables
# FLASK_ENV=development
# SECRET_KEY=replace_with_a_secure_value
